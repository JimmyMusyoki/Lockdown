{
  "name": "lockdown-blocker",
  "version": "1.0.0",
  "description": "A Cold Turkey-style website & app blocker with a lock timer",
  "main": "main.js",
  "author": "Jimmy",
  "license": "MIT",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "build": "electron-builder",
    "dist": "npm run build",
    "publish": "electron-builder --publish always"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "node-schedule": "^2.1.1",
    "ps-list": "^8.1.1"
  },
  "build": {
    "appId": "com.jimmy.lockdownblocker",
    "productName": "Lockdown Blocker",
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "publish": {
      "provider": "github",
      "owner": "JimmyMusyoki",
      "repo": "Lockdown",
      "releaseType": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*"
    ]
  }
}
